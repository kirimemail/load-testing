# Copy to .env (git-ignored). Prefer Docker secrets in production.
# SMTP AUTH for the TEST relays only. Never log these values.
SMTP_HOST=haraka-1.test.example
SMTP_PORT=587
SMTP_USER=loadtest@test.example
SMTP_PASS=changeme
FROM_DOMAIN=loadtest.example
# Sink recipients only — never real addresses.
RECIPIENTS=sink+1@loadtest.example,sink+2@loadtest.example
TLS_VERIFY=true
GENERATORS=http://gen-1:8080,http://gen-2:8080,http://gen-3:8080,http://gen-4:8080
