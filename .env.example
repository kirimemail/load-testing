# Copy to .env (git-ignored). Prefer Docker secrets in production.
# Consumed by scripts/run-scenario.py. Precedence: scenario file < .env < environment.

# Controller management endpoint (private mgmt net only, never public).
CONTROLLER_URL=http://127.0.0.1:8081

# Relay hosts, one per generator, in order (gen-1 -> first entry, ...).
# Length must match `generators:` in the scenario file.
# Unset = every generator uses SMTP_HOST.
RELAY_HOSTS=haraka-1.test.example,haraka-2.test.example,haraka-3.test.example,haraka-4.test.example

# Fallback single relay (also the default when RELAY_HOSTS is unset).
SMTP_HOST=haraka-1.test.example
SMTP_PORT=587

# SMTP AUTH for the TEST relays only. Never log these values.
SMTP_USER=loadtest@test.example
SMTP_PASS=changeme

# Dedicated test domain + controlled sink recipients. Never real addresses.
FROM_DOMAIN=loadtest.example
RECIPIENTS=sink+1@loadtest.example,sink+2@loadtest.example
TLS_VERIFY=true

# Optional per-run overrides (the scenario file provides defaults):
# TARGET_RATE=500
# DURATION_SECS=1800
# PAYLOAD_BYTES=10240
# PROFILE=persistent
# CONNECTIONS=50
# MAX_DURATION_SECS=1860
