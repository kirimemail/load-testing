FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /generator ./cmd/generator

FROM alpine:3.20
RUN adduser -D -s /bin/sh loadtest && apk add --no-cache ca-certificates
USER loadtest
COPY --from=build /generator /generator
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1:8080/health || exit 1
ENTRYPOINT ["/generator"]
