FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /controller ./cmd/controller

FROM alpine:3.20
RUN adduser -D -s /bin/sh loadtest && apk add --no-cache ca-certificates
USER loadtest
COPY --from=build /controller /controller
EXPOSE 8081
HEALTHCHECK --interval=15s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1:8081/health || exit 1
ENTRYPOINT ["/controller"]
